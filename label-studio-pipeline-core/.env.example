# ===========================================
#  Label Studio Pipeline 环境变量配置
# ===========================================

# Label Studio API Key
# 首次启动后从 Account & Settings → Access Token 获取
LABEL_STUDIO_API_KEY=

# 服务端口
LS_PORT=8080
ML_PORT=9090

# YOLO 模型配置
# 默认 yolov8n.pt (自动下载), 自定义模型放入 models/ 目录
MODEL_PATH=yolov8n.pt

# 检测阈值
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
