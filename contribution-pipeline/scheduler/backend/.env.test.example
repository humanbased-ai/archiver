# 测试专用环境变量. 测试与 dev/prod 必须用不同的库, 否则:
#   - 测试 worker (e.g. w-D3a) 会抢走 dev 真实 outbox 行
#   - 测试 cleanup 会清掉 dev 数据
# helpers.ts 启动时 assert DATABASE_URL 必须以 _test / _e2e 结尾, 严禁误用.
DATABASE_URL=postgres://scheduler:scheduler@127.0.0.1:5432/scheduler_test
PORT=4001
HOST=127.0.0.1
LOG_LEVEL=warn
AUTH_REQUIRED=false
# 测试 helpers 走 HTTP 打这个地址 (避开 dev 4000)
SCHEDULER_BASE=http://127.0.0.1:4001
