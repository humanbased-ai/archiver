          "templateId": "SPEECH_TPL_000001",
          "data": {
            "language": "en",
            "speech_audio": [
              { "uid": "rc-upload-1747981686593-6", "url": "https://file.b18a.io/6156810753500102141_975192_.mp3", "name": "Enrollment_1.mp3" }
            ],
            "speech_text": "hello,hi"
          }
        }
      ],
      "valid_data_for_validation": {
        "taskId": "7528449925900103576",
        "templateId": "SPEECH_TPL_000001",
        "data": {
          "language": "en",
          "speech_audio": [
            { "uid": "rc-upload-1747981686593-6", "url": "https://file.b18a.io/6156810753500102141_975192_.mp3", "name": "Enrollment_1.mp3" }
          ],
          "speech_text": "hello,hi"
        }
      },
      "invalid_data_for_validation": {
        "taskId": "7528449925900103576",
        "templateId": "SPEECH_TPL_000001",
        "data": {
          "language": 123,
          "speech_audio": [
            { "uid": "rc-upload-1747981686593-6", "url": "badprotocol://file.b18a.io/audio.mp3", "name": "invalid_audio.mp3" }
          ],
