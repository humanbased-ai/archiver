    {
      "case_name": "FoodDataPromptTest",
      "description_for_prompt_generation": "Validate food item data. 'taskId' must be a non-empty string. 'templateId' must be a string starting with 'FOOD_TPL_'. 'data' must be an object containing 'images' (an array of image objects, each with 'uid', 'url' (HTTPS), and 'name' strings) and 'food_description' (a non-empty string).",
      "example_data_for_prompt_generation": [
        {
          "taskId": "7528085182000103499",
          "templateId": "FOOD_TPL_000001",
          "data": {
            "images": [
              {
                "uid": "rc-upload-1747981686593-28",
                "url": "https://file.b18a.io/6156810753500102141_220828_.webp",
                "name": "u=1354488648,1434448537&fm=253&fmt=auto&app=138&f=JPEG.webp"
              }
            ],
            "food_description": "kinds of food"
          }
        }
      ],
      "valid_data_for_validation": {
        "taskId": "7528085182000103499",
        "templateId": "FOOD_TPL_000001",
        "data": {
          "images": [
            {
              "uid": "rc-upload-1747981686593-28",
              "url": "https://file.b18a.io/6156810753500102141_220828_.webp",
              "name": "u=1354488648,1434448537&fm=253&fmt=auto&app=138&f=JPEG.webp"
            }
          ],
          "food_description": "kinds of food"
        }
      },
      "invalid_data_for_validation": {
        "taskId": "7528085182000103499",
        "templateId": "INVALID_FOOD_TPL_001",
        "data": {
          "images": [
            {
              "uid": "rc-upload-1747981686593-28",
              "url": "http://file.b18a.io/image.webp",
              "name": "some_image.webp"
            }
          ],
          "food_description": 12345
        }
      },
      "expected_invalid_reason_keywords": ["templateId", "prefix", "url", "HTTPS", "food_description", "string", "number"]
    },
