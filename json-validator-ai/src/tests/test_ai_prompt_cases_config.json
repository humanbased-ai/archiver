    {
      "case_name": "SpeechDataPromptTest",
      "description_for_prompt_generation": "Validate speech data. 'taskId' must be a non-empty string. 'templateId' must be a string starting with 'SPEECH_TPL_'. 'data' must be an object containing 'language' (a string like 'en'), 'speech_audio' (an array of audio objects, each with 'uid', 'url' (HTTPS), and 'name' strings), and 'speech_text' (a non-empty string).",
      "example_data_for_prompt_generation": [
        {
