# Server Configuration
ENV=dev
API_TIMEOUT=2000

# Database Configuration
DB_URL=mysql://user:password@localhost:3306/ifsci_db?charset=utf8mb4&maxsize=20

# Redis Configuration
REDIS_TYPE=1  # 1 for single node, 2 for cluster
REDIS_CLUSTER_URL=localhost:6379
REDIS_URL=localhost:6379
REDIS_PREFIX=de_risk
REDIS_EXPIRE=1800  # 30*60 seconds

# API Keys and External Services
OPEN_AI_KEY=your_openai_key_here
LARK_SERVER_URL=your_lark_webhook_url_here

# External Service URLs
CODATA_HOST=https://app-test.example.com
ADMIN_HOST=https://admin-test.example.com

# Scheduler Configuration
INIT_SCHEDULER=0
